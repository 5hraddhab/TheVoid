# ==============================================================================
# THE VOID — AI-Powered Universe Simulator Configuration
# ==============================================================================

# Backend Server Port (defaults to 3001)
PORT=3001

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
# NEVER commit your actual .env file or expose this key to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
# Recommended free-tier models:
# - gemini-2.5-flash (fast, balanced, structured JSON support)
# - gemini-2.0-flash
# - gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
